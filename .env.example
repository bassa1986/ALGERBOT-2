# --- Database (PivotCloud PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/algerbot

# --- Sessions ---
SESSION_SECRET=replace-with-a-long-random-secret
# Full origin (scheme+host+port) of this deployment, used to validate the
# Origin header on non-GET admin server functions (CSRF defense).
APP_ORIGIN=https://algerbot.example.com

# --- Transactional email (admin password reset) ---
# Uses this project's own built-in SMTP client (src/lib/smtp.ts) -- no
# external mail package or API. For Gmail: host=smtp.gmail.com, port=465,
# user=your Gmail address, pass=an "App Password" (Google Account >
# Security > 2-Step Verification > App Passwords), NOT your normal
# password -- Google rejects plain password SMTP auth.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your-gmail-address@gmail.com
EMAIL_SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail-address@gmail.com

# --- WhatsApp Cloud API (Meta) — full order Flow ---
# Lets a buyer place a real order (product, quantity, delivery details)
# entirely inside WhatsApp via a multi-screen Flow, going through the
# SAME createOrder() logic (stock lock, price re-validation, delivery
# zone check) as the web checkout — not a separate/weaker order path.
# Requires a Meta Business Account, a Meta App with the WhatsApp product
# added, and a verified WhatsApp Business phone number. None of this is
# set up automatically — see Meta App Dashboard > WhatsApp.
#
# WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN: WhatsApp > API Setup.
# Use a permanent (System User) access token for production, not the
# 24-hour temporary token shown by default.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_API_VERSION=v21.0

# WHATSAPP_FLOW_ID: the published Flow's ID, from WhatsApp > Flows, after
# creating a Flow with the JSON in src/lib/whatsapp-flow-definition.ts.
WHATSAPP_FLOW_ID=your-flow-id

# WHATSAPP_FLOW_PRIVATE_KEY: the PEM-format RSA private key whose PUBLIC
# key you uploaded to Meta (WhatsApp > Configuration > Flows >
# Encryption). Generate a pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then upload public.pem's contents to Meta and put private.pem's full
# contents here (keep the literal newlines, wrap the value in quotes).
WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxxx...\n-----END PRIVATE KEY-----"

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: any string you choose, entered again in
# WhatsApp > Configuration > Webhook when registering the callback URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-string

# WHATSAPP_APP_SECRET: your Meta App's secret (App Dashboard > Settings >
# Basic > App Secret). Used to verify the X-Hub-Signature-256 header Meta
# sends on every webhook POST, so this app only trusts webhook events that
# are actually cryptographically signed by Meta — without this, anyone who
# discovers the webhook URL could POST a forged "order completed" event.
WHATSAPP_APP_SECRET=your-meta-app-secret

# --- Adex (S3-compatible object storage) ---
ADEX_ENDPOINT=https://adex.example.com
ADEX_REGION=us-east-1
ADEX_BUCKET=algerbot
ADEX_ACCESS_KEY_ID=replace-me
ADEX_SECRET_ACCESS_KEY=replace-me
ADEX_PUBLIC_BASE_URL=https://cdn.example.com/algerbot

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Used by the Telegram Login Widget on the web (same bot as TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_USERNAME=AlgerBotBot
# Same value, exposed to client-side code (Vite requires the VITE_ prefix to
# ship a var to the browser bundle). This is not secret — it's the bot's
# public @handle — only TELEGRAM_BOT_TOKEN itself must stay server-only.
VITE_TELEGRAM_BOT_USERNAME=AlgerBotBot
# The Mini App "short name" registered against this bot in BotFather
# (/newapp), used to build t.me/<username>/<short-name>?startapp=... deep
# links. Not secret. Must match exactly what BotFather has on file, or the
# link will fail to open the Mini App.
VITE_TELEGRAM_MINIAPP_SHORT_NAME=store
# Optional. Facebook App ID, required only for the Messenger "share to
# Messenger" deep link (fb-messenger:// / dialog/send). Without it, the
# Messenger share option falls back to the plain Facebook sharer instead
# of erroring. Get one at https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=

# --- BaridiMob billing ---
BARIDIMOB_RIB=00799999000123456789
BARIDIMOB_ACCOUNT_NAME=AlgerBot SARL

# --- Background removal (rembg, self-hosted) ---
# Point this at a rembg server-mode instance (`rembg s --host 0.0.0.0 --port 7000`)
# deployed as its own server — e.g. an Adex Cloud "Serveurs" instance, not the
# Adex object-storage product used for ADEX_* above. Leave unset to disable
# background removal entirely; product photo uploads then keep the original
# background, which is the safe fallback.
REMBG_SERVICE_URL=http://your-rembg-host:7000

